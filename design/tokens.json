{
  "$description": "Design tokens: single source of truth for color, type, space and radius. Run `npm run tokens` after editing; it writes src/shared/styles/tokens.css. CI fails if the CSS is stale (`npm run tokens:check`).",
  "color": {
    "themes": ["light", "dark"],
    "tokens": {
      "bg": { "light": "#ffffff", "dark": "#0f1115", "usage": "Page ground." },
      "bg-subtle": { "light": "#f6f7fb", "dark": "#14171d", "usage": "Alternate section band." },
      "surface": { "light": "#ffffff", "dark": "#181b22", "usage": "Cards, panels, forms." },
      "surface-raised": { "light": "#f1f2f8", "dark": "#20242d", "usage": "Hover of cards, chips, inputs." },
      "line": { "light": "#e3e5ee", "dark": "#2a2e38", "usage": "Hairline borders and dividers." },
      "line-strong": {
        "light": "#c7cad8",
        "dark": "#3b404c",
        "usage": "Input and secondary button borders."
      },
      "ink": { "light": "#14151a", "dark": "#f3f4f7", "usage": "Headings and primary text." },
      "ink-muted": { "light": "#4a4d5c", "dark": "#c4c7d1", "usage": "Body text." },
      "ink-subtle": { "light": "#5f6375", "dark": "#9a9eac", "usage": "Captions, dates, footer. Min 14px." },
      "accent": { "light": "#4f46e5", "dark": "#a5b4fc", "usage": "Primary buttons, links, eyebrows." },
      "accent-hover": { "light": "#4338ca", "dark": "#c7d2fe", "usage": "Hover of accent." },
      "on-accent": { "light": "#ffffff", "dark": "#0f1115", "usage": "Text on accent backgrounds." },
      "success": { "light": "#047857", "dark": "#6ee7b7", "usage": "Success messages. Always with text." },
      "danger": {
        "light": "#b42318",
        "dark": "#fca5a5",
        "usage": "Errors. Always with text, never color alone."
      },
      "focus": { "light": "#4f46e5", "dark": "#a5b4fc", "usage": "Focus ring." }
    }
  },
  "font": {
    "sans": "'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "text": {
    "display": {
      "size": "clamp(2.25rem, 1.5rem + 3vw, 3.75rem)",
      "lineHeight": 1.05,
      "weight": 800,
      "tracking": "-0.02em",
      "usage": "Hero H1. One per page."
    },
    "h2": {
      "size": "clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem)",
      "lineHeight": 1.15,
      "weight": 750,
      "tracking": "-0.015em",
      "usage": "Section headings."
    },
    "h3": { "size": "1.125rem", "lineHeight": 1.3, "weight": 700, "usage": "Card titles." },
    "lead": {
      "size": "1.25rem",
      "lineHeight": 1.5,
      "weight": 400,
      "usage": "Intro paragraph under a heading."
    },
    "body": { "size": "1rem", "lineHeight": 1.65, "weight": 400, "usage": "Paragraphs." },
    "small": { "size": "0.875rem", "lineHeight": 1.55, "weight": 400, "usage": "Captions, nav, buttons." },
    "eyebrow": {
      "size": "0.8125rem",
      "lineHeight": 1.2,
      "weight": 650,
      "tracking": "0.08em",
      "usage": "Uppercase label above a heading."
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2.5rem",
    "7": "clamp(3.5rem, 2rem + 6vw, 5.5rem)"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "pill": "999px"
  },
  "layout": {
    "content-max": "1120px",
    "prose-max": "68ch",
    "gutter": "clamp(1rem, 0.5rem + 2vw, 1.5rem)",
    "touch-target": "44px"
  }
}
