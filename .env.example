# Copy to .env.local for local overrides. Every VITE_* value is inlined into the public bundle:
# never put a secret here. The schema in src/shared/config/env.schema.ts validates all of them and the
# build fails on a malformed value.

# Canonical origin of the site, no trailing slash. Used for canonical URLs, hreflang, Open Graph
# and sitemap.xml. Defaults to https://example.com.
VITE_SITE_URL=https://example.com

# "false" for staging/preview builds: every page gets <meta name="robots" content="noindex">,
# robots.txt disallows everything and no sitemap is written. Defaults to "true".
VITE_ALLOW_INDEXING=true

# GA4 measurement id (G-XXXXXXXXXX). Empty = no analytics. Only loads in production builds.
VITE_GA_MEASUREMENT_ID=

# Base URL of the API that receives the contact form (POST {VITE_API_URL}/contact).
# Empty = the form simulates a successful send (useful for demos and e2e).
VITE_API_URL=

# Commit of the build, shown in the footer. CI sets it to github.sha; locally it can stay empty.
VITE_APP_COMMIT=
