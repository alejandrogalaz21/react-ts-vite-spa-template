{
  "name": "react-ts-vite-spa-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Base template for React + TypeScript + Vite SPAs with static prerender, SEO, i18n and analytics.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve-static.mjs",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "knip": "knip",
    "check": "npm run tokens:check && npm run typecheck && npm run lint && npm run format:check && npm run knip && npm test && npm run test:scripts && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "storybook": "^10.6.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
